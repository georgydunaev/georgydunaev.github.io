[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
  sshCommand = ssh -o IdentitiesOnly=yes -i ~/.ssh_my/githubpass_ed25519
[remote "github"]
	url = git@github.com:georgydunaev/georgydunaev.github.io.git
	fetch = +refs/heads/*:refs/remotes/github/*
[remote "gitlab"]
	url = http://192.168.0.3:8929/georgydunaev/georgydunaev.github.io.git
	fetch = +refs/heads/*:refs/remotes/gitlab/*
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = false
[user]
	name = G.D.
	email = contact@obelisk.mozmail.com
  signingKey = /home/user/.ssh_my/githubpass_ed25519.pub
[gpg]
  format = ssh
[commit]
  gpgsign = true
[remote]
	pushDefault = github
[branch "main"]
	pushRemote = github
